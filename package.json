{
  "name": "dsh-context-compressor",
  "version": "1.1.0",
  "description": "User-set context trigger for DeepSeek Harness: pick an absolute token ceiling or a share of the routed model's context window, and the harness compacts the conversation automatically once a session reaches it. Ships a dedicated settings page (host half + browser half).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AllShadowAnan/dsh-context-compressor.git"
  },
  "homepage": "https://github.com/AllShadowAnan/dsh-context-compressor#readme",
  "bugs": {
    "url": "https://github.com/AllShadowAnan/dsh-context-compressor/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "icon": "./icon.svg",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "compaction",
    "context-window",
    "token-limit",
    "settings"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "test": "node --test test/host.test.mjs test/settings-projection.test.mjs test/client.test.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "devDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
